APP_NAME=HireLens AI API
# development | production | test
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://hirelens:hirelens_dev_password_change_me@localhost:5432/hirelens

JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# Rate limiting - login guards against password guessing, upload against unbounded file parsing,
# screening against burning the free-tier AI quota.

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_SCREENING_PER_MINUTE=20

# -----------------------------------------------------------------------------
# LLM providers - fallback chain
# PRIVACY NOTE: Free tiers commonly permit training on submitted data. Only
# PII-redacted text is ever sent, but for real candidate data prefer Ollama,
# which keeps everything on the host.
# -----------------------------------------------------------------------------
AI_PROVIDER_ORDER=gemini,groq,ollama
AI_PROVIDER_TIMEOUT_SECONDS=20

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Local Ollama: the only provider trusted with unredacted text.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=all-MiniLM-L6-v2

UPLOAD_STORAGE_PATH=./storage/resumes
MAX_RESUME_SIZE_MB=10

# Redacts candidate names and addresses before any external LLM call. Disabling
# this does not disable the fairness counterfactual, which always strips names.
PII_REDACT_NAMES=true